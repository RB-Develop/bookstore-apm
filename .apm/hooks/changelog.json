{
  "description": "After a git commit, ask the agent to bring CHANGELOG.md up to date with the changelog skill.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/run-changelog.py\""
          }
        ]
      }
    ]
  }
}
